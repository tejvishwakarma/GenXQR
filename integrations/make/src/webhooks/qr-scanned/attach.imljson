{
  "url": "/v1/webhooks",
  "method": "POST",
  "body": {
    "url": "{{webhook.url}}",
    "event": "qr.scanned",
    "source": "make",
    "name": "Make — qr.scanned"
  },
  "response": {
    "data": {
      "webhookId": "{{body.data.id}}"
    },
    "error": {
      "message": "[{{statusCode}}] {{body.error}}"
    }
  }
}
