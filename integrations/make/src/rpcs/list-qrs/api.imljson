{
  "url": "/v1/qr",
  "method": "GET",
  "qs": {
    "page": 1,
    "limit": 50,
    "sort": "updatedAt"
  },
  "pagination": {
    "qs": {
      "page": "{{pagination.page}}"
    },
    "condition": "{{body.pagination.hasNext}}"
  },
  "response": {
    "limit": 150,
    "iterate": "{{body.data}}",
    "output": {
      "label": "{{item.name}}",
      "value": "{{item.id}}"
    },
    "error": {
      "message": "[{{statusCode}}] {{body.error}}"
    }
  }
}
