{
  "url": "/v1{{parameters.url}}",
  "method": "{{parameters.method}}",
  "headers": "{{toCollection(parameters.headers, 'key', 'value')}}",
  "qs": "{{toCollection(parameters.qs, 'key', 'value')}}",
  "body": "{{parameters.body}}",
  "response": {
    "output": {
      "headers": "{{headers}}",
      "statusCode": "{{statusCode}}",
      "body": "{{body}}"
    }
  }
}
