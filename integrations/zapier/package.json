{
  "name": "genxqr-zapier",
  "version": "1.0.0",
  "description": "GenXQR integration for Zapier \u2014 create QR codes, manage destinations, and trigger Zaps on scan events.",
  "main": "dist/index.js",
  "private": true,
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "jest --passWithNoTests",
    "validate": "pnpm build && zapier-platform validate",
    "push": "pnpm build && zapier-platform push",
    "deploy": "pnpm build && zapier-platform push"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "zapier-platform-core": "19.2.1"
  },
  "devDependencies": {
    "@types/node": "20.11.0",
    "typescript": "5.5.4",
    "jest": "29.7.0"
  }
}
