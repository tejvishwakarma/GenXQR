generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  /// Email reduced to its canonical form: lowercased, `+tag` stripped, and dots
  /// removed for Gmail. Used ONLY to decide whether this person has already had
  /// a free trial — `user+1@gmail.com` and `u.s.e.r@gmail.com` are the same
  /// inbox. Deliberately NOT unique: signing up with an alias stays allowed, it
  /// just does not earn a second trial. Indexed because it is looked up on every
  /// trial grant.
  normalizedEmail         String?
  emailVerified           Boolean                  @default(false)
  passwordHash            String?
  name                    String
  /// Customer mobile number, 10 digits, no country code. Collected at first
  /// checkout because Cashfree requires one on every order; reused afterwards so
  /// returning customers are not asked again.
  phone                   String?
  avatarUrl               String?
  googleId                String?                  @unique
  driveConnected          Boolean                  @default(false)
  driveFolderId           String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  lastLoginAt             DateTime?
  role                    Role                     @default(USER)
  driveAccessToken        String?
  driveRefreshToken       String?
  driveTokenExpiresAt     DateTime?
  notificationPrefs       Json?
  apiKeys                 ApiKey[]
  auditLogs               AuditLog[]
  emailVerificationTokens EmailVerificationToken[]
  invoices                Invoice[]
  notifications           Notification[]
  passwordResetTokens     PasswordResetToken[]
  qrCodes                 QRCode[]
  refreshTokens           RefreshToken[]
  subscription            Subscription?
  supportTickets          SupportTicket[]
  ticketMessages      TicketMessage[]
  teamInvitesSent         TeamInvite[]             @relation("UserTeamInvitesSent")
  teamMemberships         TeamMember[]
  couponRedemptions       CouponRedemption[]
  teamsOwned              Team[]                   @relation("UserTeamsOwned")
  webhooks                Webhook[]

  @@index([normalizedEmail])
  // No explicit @@index([email]) — the @unique on the email field above
  // already creates a backing index; a second one just duplicates write cost.
  @@map("users")
}

model Plan {
  id              String         @id @default(cuid())
  name            PlanName       @unique
  displayName     String
  priceMonthlyINR Int
  priceYearlyINR  Int
  priceMonthlyUSD Int
  priceYearlyUSD  Int
  dynamicQRLimit  Int
  scanLimit       Int
  fileStorageGB   Int
  teamSeatsLimit  Int
  apiCallsLimit   Int
  features        Json
  subscriptions   Subscription[]

  @@map("plans")
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String             @unique
  planId             String
  status             SubscriptionStatus
  trialEndsAt        DateTime?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  invoices           Invoice[]
  plan               Plan               @relation(fields: [planId], references: [id])
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model QRCode {
  id                  String             @id @default(cuid())
  userId              String?
  type                QRType
  category            QRCategory
  name                String
  slug                String             @unique
  tags                String[]
  isActive            Boolean            @default(true)
  /// Every scan, repeats included. This is the number the per-QR scanLimit is
  /// measured against.
  scanCount           Int                @default(0)
  /// Distinct devices, by the same rule as QRScan.isUnique.
  uniqueScanCount     Int                @default(0)
  isPasswordProtected Boolean            @default(false)
  passwordHash        String?
  activeFrom          DateTime?
  activeUntil         DateTime?
  scanLimit           Int?
  fallbackUrl         String?
  abTestEnabled       Boolean            @default(false)
  abTestSplitPct      Int                @default(50)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  lastScannedAt       DateTime?
  fbPixelId           String?
  gaId                String?
  gtmId               String?
  abVariants          ABTestVariant[]
  abuseReports        AbuseReport[]
  user                User?              @relation(fields: [userId], references: [id])
  content             QRContent?
  design              QRDesign?
  files               QRFile[]
  scanDailies         QRScanDaily[]
  scans               QRScan[]
  smartRoutes         SmartRoutingRule[]

  @@index([userId])
  @@index([slug])
  @@index([type])
  @@index([createdAt])
  @@map("qr_codes")
}

model QRContent {
  id        String   @id @default(cuid())
  qrId      String   @unique
  data      Json
  updatedAt DateTime @updatedAt
  qrCode    QRCode   @relation(fields: [qrId], references: [id], onDelete: Cascade)

  @@map("qr_content")
}

model QRDesign {
  id                 String   @id @default(cuid())
  qrId               String   @unique
  primaryColor       String   @default("#000000")
  secondaryColor     String   @default("#ffffff")
  backgroundColor    String   @default("#ffffff")
  foregroundColor    String   @default("#000000")
  dotStyle           String   @default("square")
  cornerSquareStyle  String   @default("square")
  cornerDotStyle     String   @default("square")
  gradientEnabled    Boolean  @default(false)
  gradientType       String?
  gradientColor1     String?
  gradientColor2     String?
  logoUrl            String?
  logoSize           Int      @default(40)
  logoMargin         Int      @default(5)
  hideBackgroundDots Boolean  @default(true)
  frameStyle         String?
  frameText          String?
  frameColor         String?
  paletteId          String?
  fontTitle          String   @default("Inter")
  fontBody           String   @default("Inter")
  welcomeScreenUrl   String?
  updatedAt          DateTime @updatedAt
  qrCode             QRCode   @relation(fields: [qrId], references: [id], onDelete: Cascade)

  @@map("qr_design")
}

model QRFile {
  id            String   @id @default(cuid())
  qrId          String
  fileType      FileType
  fileName      String
  fileUrl       String
  mimeType      String
  sizeBytes     BigInt
  thumbnailUrl  String?
  driveFileId   String?
  driveBackedUp Boolean  @default(false)
  uploadedAt    DateTime @default(now())
  qrCode        QRCode   @relation(fields: [qrId], references: [id], onDelete: Cascade)

  @@map("qr_files")
}

model QRScan {
  id          String     @id @default(cuid())
  qrId        String
  scannedAt   DateTime   @default(now())
  /// False when the same device+IP already scanned this code inside the dedup
  /// window. Every scan is stored now; this is what separates total from unique.
  /// Historical rows are all true because the old code only ever stored uniques.
  isUnique    Boolean    @default(true)
  ip          String
  country     String?
  countryCode String?
  city        String?
  region      String?
  lat         Float?
  lng         Float?
  deviceType  DeviceType @default(UNKNOWN)
  os          String?
  browser     String?
  userAgent   String?
  referrer    String?
  abVariantId String?
  qrCode      QRCode     @relation(fields: [qrId], references: [id], onDelete: Cascade)

  @@index([qrId, scannedAt])
  @@index([qrId, country])
  @@index([scannedAt])
  @@map("qr_scans")
}

model QRScanDaily {
  id          String   @id @default(cuid())
  qrId        String
  date        DateTime @db.Date
  /// Total scans that day, including repeats from the same device.
  count       Int      @default(0)
  /// Distinct devices that day, by the same rule as QRScan.isUnique.
  uniqueCount Int      @default(0)
  qrCode      QRCode   @relation(fields: [qrId], references: [id], onDelete: Cascade)

  // @@unique below already backs lookups/upserts on [qrId, date] with an
  // index — no need for a duplicate @@index on the identical columns.
  @@unique([qrId, date])
  @@map("qr_scan_daily")
}

model SmartRoutingRule {
  id             String   @id @default(cuid())
  qrId           String
  priority       Int
  conditionType  String
  conditionValue Json
  targetUrl      String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  qrCode         QRCode   @relation(fields: [qrId], references: [id], onDelete: Cascade)

  @@index([qrId, priority])
  @@map("smart_routing_rules")
}

model ABTestVariant {
  id        String   @id @default(cuid())
  qrId      String
  name      String
  targetUrl String
  splitPct  Int
  scanCount Int      @default(0)
  createdAt DateTime @default(now())
  qrCode    QRCode   @relation(fields: [qrId], references: [id], onDelete: Cascade)

  @@map("ab_test_variants")
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  keyHash    String    @unique
  keyPrefix  String
  lastUsedAt DateTime?
  callCount  Int       @default(0)
  isActive   Boolean   @default(true)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // apikey.middleware.ts looks up active keys by keyPrefix on every /v1/*
  // request — without this, that's an unindexed scan across all API keys.
  @@index([keyPrefix])
  @@map("api_keys")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityId   String?
  entityType String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())
  category   String   @default("system")
  userAgent  String?
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([category, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model Webhook {
  id         String            @id @default(cuid())
  userId     String
  name       String
  url        String
  events     String[]
  secret     String
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  /// Opaque external id (e.g. Zapier subscription id) echoed back on subscribe
  externalId String?
  /// null = user-created via dashboard; "zapier" | "make" | "n8n" for integration-owned hooks
  source     String?
  deliveries WebhookDelivery[]
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, source])
  @@map("webhooks")
}

model WebhookDelivery {
  id            String    @id @default(cuid())
  webhookId     String
  event         String
  payload       Json
  statusCode    Int?
  responseBody  String?
  success       Boolean
  attemptedAt   DateTime  @default(now())
  /// Retry state — incremented on each failed redelivery attempt
  attemptNumber Int       @default(1)
  lastError     String?
  maxAttempts   Int       @default(5)
  /// Set when delivery fails and further attempts remain; cleared once success or exhausted
  nextRetryAt   DateTime?
  webhook       Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, attemptedAt])
  @@index([success, nextRetryAt])
  @@map("webhook_deliveries")
}

model RefreshToken {
  id        String    @id
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

model Invoice {
  id                String       @id @default(cuid())
  userId            String
  subscriptionId    String
  amount            Int
  currency          String       @default("INR")
  status            String
  planName          PlanName
  billingCycle      String
  periodStart       DateTime
  periodEnd         DateTime
  createdAt         DateTime     @default(now())
  // Cashfree's own payment reference (cf_order_id), for reconciliation.
  cashfreePaymentId String?
  // The order_id we generate and send to Cashfree. UNIQUE because it is the
  // idempotency key: both the webhook and the browser-return verification race
  // to activate the same subscription, and this constraint is what makes the
  // loser fail instead of double-charging or double-extending the period.
  cashfreeOrderId   String?      @unique
  subscription      Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("invoices")
}

/// A discount code created by a super-admin and redeemed by a customer at checkout.
///
/// Discounts apply to the FIRST payment of a subscription, not to renewals —
/// renewals are separate Cashfree orders created without a coupon.
model Coupon {
  id               String             @id @default(cuid())
  /// Always stored UPPERCASE and matched case-insensitively, so "save20" and
  /// "SAVE20" are one coupon rather than two.
  code             String             @unique
  /// Shown to the admin in listings; never shown to the customer.
  description      String?
  discountType     CouponDiscountType
  /// PERCENTAGE: whole percent, 1-100. FIXED: an amount in PAISE.
  /// Two meanings in one column is a compromise, but a second nullable column
  /// invites the pair getting out of step.
  discountValue    Int
  /// Caps what a percentage coupon can take off, in paise. Ignored for FIXED.
  /// Without this, "50% off" on the yearly BUSINESS plan is a ₹11,994 giveaway.
  maxDiscountPaise Int?
  /// Order must be at least this much (paise) before the coupon applies.
  minOrderPaise    Int?

  /// Empty array = every plan. Restricts which plans the code works on.
  applicablePlans  PlanName[]
  /// Empty array = both. Values are "monthly" / "yearly".
  applicableCycles String[]

  /// Total redemptions allowed across all users. Null = unlimited.
  maxRedemptions        Int?
  /// Per-user cap. 1 means each customer may use it once.
  maxRedemptionsPerUser Int  @default(1)
  /// Incremented atomically on redemption; the source of truth for maxRedemptions.
  redemptionCount       Int  @default(0)

  validFrom  DateTime?
  validUntil DateTime?
  isActive   Boolean   @default(true)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  redemptions CouponRedemption[]

  @@index([code])
  @@index([isActive, validUntil])
  @@map("coupons")
}

/// One successful use of a coupon, written in the same transaction that activates
/// the subscription.
model CouponRedemption {
  id       String @id @default(cuid())
  couponId String
  userId   String

  /// The Cashfree order this discount was applied to. UNIQUE, so a replayed
  /// webhook or a raced browser-return cannot record the same redemption twice
  /// or double-count it against the coupon's limit.
  cashfreeOrderId String @unique

  /// All in paise, kept for audit: what the plan lists at, what came off, and
  /// what was actually charged.
  originalPaise Int
  discountPaise Int
  finalPaise    Int

  planName     PlanName
  billingCycle String
  redeemedAt   DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
  @@map("coupon_redemptions")
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

model SupportTicket {
  id         String         @id @default(cuid())
  userId     String
  subject    String
  /// The opening message. Superseded by TicketMessage, which now holds the whole
  /// thread including this first entry (backfilled by migration). Kept rather than
  /// dropped so nothing that still reads it breaks, but the thread is the source of
  /// truth for display.
  message    String
  status     TicketStatus   @default(OPEN)
  priority   TicketPriority @default(MEDIUM)
  assignedTo String?
  adminNotes String?
  resolvedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  category   String         @default("general")
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   TicketMessage[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("support_tickets")
}

/// One message in a support conversation, from either side.
///
/// isStaff is stored rather than derived from the author's current role: a support
/// agent may later be demoted, or their account deleted, and a reply must not
/// silently become a customer message years after it was written. authorId is
/// nullable for the same reason — the thread outlives the account.
model TicketMessage {
  id        String        @id @default(cuid())
  ticketId  String
  authorId  String?
  /// True when written by support staff. Fixed at write time, never recomputed.
  isStaff   Boolean       @default(false)
  body      String
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

model AbuseReport {
  id         String    @id @default(cuid())
  qrId       String
  reportedBy String?
  reason     String
  url        String?
  isResolved Boolean   @default(false)
  resolvedBy String?
  adminNotes String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  qrCode     QRCode    @relation(fields: [qrId], references: [id], onDelete: Cascade)

  @@index([qrId])
  @@index([isResolved])
  @@map("abuse_reports")
}

model Blocklist {
  id          String   @id @default(cuid())
  type        String
  value       String
  reason      String?
  addedBy     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  /// How many times this email has been deleted/blocked by an admin.
  /// Once this reaches 3 the entry becomes permanently banned and cannot be removed.
  blockCount  Int      @default(1)
  isPermanent Boolean  @default(false)

  @@unique([type, value])
  @@index([type, isActive])
  @@map("blocklist")
}

model LimitAlert {
  id        String   @id @default(cuid())
  userId    String
  limitType String
  threshold Int
  periodKey String
  sentAt    DateTime @default(now())

  @@unique([userId, limitType, threshold, periodKey])
  @@index([userId])
  @@map("limit_alerts")
}

model RenewalReminder {
  id             String   @id @default(cuid())
  subscriptionId String
  userId         String
  /// "7_days" | "3_days" | "1_day" | "expired" | "manual"
  reminderType   String
  /// YYYY-MM-DD of currentPeriodEnd for auto; YYYY-MM-DD of send date for manual
  periodKey      String
  sentAt         DateTime @default(now())
  /// "sent" | "failed"
  status         String
  error          String?

  @@unique([subscriptionId, reminderType, periodKey])
  @@index([subscriptionId])
  @@index([userId])
  @@index([sentAt])
  @@map("renewal_reminders")
}

model EmailLog {
  id       String   @id @default(cuid())
  userId   String?
  to       String
  subject  String
  template String
  status   String
  error    String?
  provider String   @default("resend")
  sentAt   DateTime @default(now())

  @@index([sentAt])
  @@index([status])
  @@map("email_logs")
}

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

model Team {
  id        String       @id @default(cuid())
  name      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  ownerId   String
  invites   TeamInvite[]
  members   TeamMember[]
  owner     User         @relation("UserTeamsOwned", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("teams")
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     TeamRole @default(VIEWER)
  joinedAt DateTime @default(now())
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model TeamInvite {
  id          String    @id @default(cuid())
  teamId      String
  email       String
  token       String    @unique
  invitedBy   String
  role        TeamRole  @default(VIEWER)
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?
  expiresAt   DateTime?
  lastSentAt  DateTime  @default(now())
  resendCount Int       @default(0)
  inviter     User      @relation("UserTeamInvitesSent", fields: [invitedBy], references: [id], onDelete: Cascade)
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([email])
  @@map("team_invites")
}

model StaticQRGeneration {
  id        String   @id @default(cuid())
  type      String
  ip        String?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
  @@map("static_qr_generations")
}

model JobPosting {
  id           String           @id @default(cuid())
  title        String
  department   String?
  location     String?
  type         String
  description  String
  status       JobStatus        @default(OPEN)
  postedAt     DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  applications JobApplication[]

  @@index([status])
  @@index([postedAt])
  @@map("job_postings")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  body      String
  actionUrl String?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model JobApplication {
  id          String            @id @default(cuid())
  jobId       String?
  jobTitle    String
  name        String
  email       String
  phone       String?
  linkedin    String?
  experience  String?
  coverLetter String
  cvFilename  String
  status      ApplicationStatus @default(NEW)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  cvMimeType  String?
  cvPath      String?
  job         JobPosting?       @relation(fields: [jobId], references: [id])

  @@index([status])
  @@index([jobId])
  @@index([createdAt])
  @@map("job_applications")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum PlanName {
  FREE
  STARTER
  PRO
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  TRIALING
  PAUSED
}

enum QRType {
  URL
  PDF
  VIDEO
  LINKS
  SOCIAL_MEDIA
  VCARD
  IMAGE_GALLERY
  BUSINESS
  APP
  MP3
  MENU
  WIFI
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  COUPON
}

enum QRCategory {
  STATIC
  DYNAMIC
}

enum FileType {
  PDF
  MP3
  VIDEO
  IMAGE
}

enum DeviceType {
  MOBILE
  TABLET
  DESKTOP
  UNKNOWN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TeamRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum NotificationType {
  SYSTEM
  FEATURE
  BILLING
  LIMIT
  TEAM
}

enum JobStatus {
  OPEN
  PAUSED
  FILLED
  CLOSED
}

enum ApplicationStatus {
  NEW
  REVIEWING
  SHORTLISTED
  REJECTED
  HIRED
}
