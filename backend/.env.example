# =============================================================================
# GenXQR Backend — Environment Variables Reference
# =============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# PRODUCTION: Secrets marked [VAULT] below are stored in HashiCorp Vault and
# are NOT needed in .env on the server. See scripts/vault-setup.sh for setup.
# Non-secret vars go in .env.production (loaded by vault-bootstrap.mjs).
# =============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Database ─────────────────────────────────────────────────────────────────
# [VAULT in production] Key: DATABASE_URL
# Local dev uses the dedicated Postgres container from /docker-compose.yml (port 5433).
# The password must match POSTGRES_PASSWORD in the root .env.
DATABASE_URL="postgresql://genxqr:change_me_dev@localhost:5433/genxqr?schema=public"

# ─── Redis ────────────────────────────────────────────────────────────────────
# [VAULT in production] Key: REDIS_URL
# Local dev uses the dedicated Redis container from /docker-compose.yml (port 6380).
# The password must match REDIS_PASSWORD in the root .env.
REDIS_URL="redis://:change_me_dev@localhost:6380"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# [VAULT in production] Keys: JWT_ACCESS_SECRET, JWT_REFRESH_SECRET
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="CHANGE_ME_USE_A_STRONG_RANDOM_64_CHAR_HEX_SECRET"
JWT_REFRESH_SECRET="CHANGE_ME_USE_A_DIFFERENT_STRONG_RANDOM_64_CHAR_HEX_SECRET"
# Expiry config — not secrets, safe in .env.production:
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# [VAULT in production] Key: GOOGLE_CLIENT_SECRET
# GOOGLE_CLIENT_ID is a public identifier — safe in .env.production.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# These two must match the "Authorized redirect URIs" on the OAuth client in
# Google Cloud Console exactly, and must match the routes the app actually
# serves. Note the Drive callback is under /api/gdrive/, NOT /api/auth/gdrive/ —
# gdrive.routes.ts is mounted at /api/gdrive (see routes/index.ts).
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"
GOOGLE_DRIVE_REDIRECT_URI="http://localhost:3001/api/gdrive/callback"

# ─── Frontend / Backend URLs ──────────────────────────────────────────────────
# Not secrets — safe in .env.production.
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:3001"

# ─── Email ────────────────────────────────────────────────────────────────────
# [VAULT in production] Keys: RESEND_API_KEY, SMTP_PASS
# SMTP_HOST, SMTP_PORT, SMTP_USER, EMAIL_FROM are not secrets — safe in .env.production.

# Option 1: Resend (recommended for production)
RESEND_API_KEY=""

# Option 2: SMTP (fallback)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

EMAIL_FROM="GenXQR <no-reply@genxqr.com>"

# ─── Cashfree Payments ────────────────────────────────────────────────────────
# The only payment gateway. Credentials: Cashfree dashboard → Developers →
# API Keys. Sandbox and production have SEPARATE key pairs — using a sandbox key
# against the production base URL fails with an opaque auth error.
#
# CASHFREE_SECRET_KEY is also the webhook signing key; Cashfree does not issue a
# separate one.
CASHFREE_APP_ID="your_app_id_here"
CASHFREE_SECRET_KEY="your_secret_key_here"
# Sandbox: https://sandbox.cashfree.com/pg   Live: https://api.cashfree.com/pg
CASHFREE_API_BASE="https://sandbox.cashfree.com/pg"
# Pins request and response shape. Confirm the version your merchant account is
# provisioned for before going live.
CASHFREE_API_VERSION="2026-01-01"

# Public origin Cashfree posts webhooks to, and that the browser returns to.
# Register <BACKEND_URL>/api/billing/cashfree-webhook in the Cashfree dashboard.
# Dev:  http://localhost:3001  (goes directly to Express, bypasses Vite proxy)
# Prod: https://genxqr.com   (Nginx proxies /api/* to the backend)

# ─── HashiCorp Vault (production only) ────────────────────────────────────────
# These are used by vault-bootstrap.mjs in production to authenticate to Vault
# and fetch the secrets marked [VAULT] above. Do NOT set these in dev.
# Set them in ecosystem.config.cjs → env_production, or via systemd EnvironmentFile.
# See: scripts/vault-setup.sh for how to generate VAULT_ROLE_ID and VAULT_SECRET_ID.
#
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_ROLE_ID=<role-id-from-vault-setup.sh>
# VAULT_SECRET_ID=<secret-id-from-vault-setup.sh>
