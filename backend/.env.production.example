# =============================================================================
# GenXQR Backend — PRODUCTION Environment Variables (genxqr.com)
# =============================================================================
# On the server:
#   cp backend/.env.production.example backend/.env
#   chmod 600 backend/.env
#   chown <cloudpanel-site-user>:<cloudpanel-site-user> backend/.env
#
# This file is loaded via Node's native --env-file flag (see ecosystem.config.cjs
# and package.json's "start" script) — no Vault, no dotenv package needed.
# NEVER commit backend/.env with real values. It's already gitignored.
# =============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ─── Database ─────────────────────────────────────────────────────────────────
# Postgres running in the docker-compose stack on this VPS (see DEPLOYMENT.md).
# Bind the container to 127.0.0.1 only — never expose 5432/5433 publicly.
DATABASE_URL="postgresql://genxqr:CHANGE_ME_STRONG_DB_PASSWORD@127.0.0.1:5433/genxqr?schema=public"

# ─── Redis ────────────────────────────────────────────────────────────────────
# Same docker-compose stack. Bind to 127.0.0.1 only.
REDIS_URL="redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@127.0.0.1:6380"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate two DIFFERENT strong secrets — never reuse dev secrets in production:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="CHANGE_ME_USE_A_STRONG_RANDOM_64_CHAR_HEX_SECRET"
JWT_REFRESH_SECRET="CHANGE_ME_USE_A_DIFFERENT_STRONG_RANDOM_64_CHAR_HEX_SECRET"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ─── Google OAuth (optional — omit to disable Google login) ──────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="https://genxqr.com/api/auth/google/callback"
GOOGLE_DRIVE_REDIRECT_URI="https://genxqr.com/api/auth/gdrive/callback"

# ─── Frontend / Backend URLs ──────────────────────────────────────────────────
FRONTEND_URL="https://genxqr.com"
BACKEND_URL="https://genxqr.com"

# ─── Email ────────────────────────────────────────────────────────────────────
# Option 1: Resend (recommended)
RESEND_API_KEY=""

# Option 2: SMTP (fallback — only used if RESEND_API_KEY is empty)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

EMAIL_FROM="GenXQR <no-reply@genxqr.com>"

# ─── PayU (live merchant credentials — get from https://dashboard.payu.in) ────
PAYU_MERCHANT_KEY="your_live_merchant_key_here"
PAYU_MERCHANT_SALT="your_live_merchant_salt_here"
# LIVE endpoint — do not use test.payu.in in production:
PAYU_BASE_URL="https://secure.payu.in/_payment"
