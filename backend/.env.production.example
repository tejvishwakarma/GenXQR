# =============================================================================
# GenXQR Backend — PRODUCTION Environment Variables (genxqr.com)
# =============================================================================
# On the server, this project keeps the real file OUTSIDE the repo entirely
# (see DEPLOYMENT.md step 4) so Nginx/git can never touch it:
#   cp backend/.env.production.example /home/genxqr/genxqr.env
#   chmod 600 /home/genxqr/genxqr.env
#   chown <cloudpanel-site-user>:<cloudpanel-site-user> /home/genxqr/genxqr.env
#
# ecosystem.config.cjs's ENV_FILE_PATH constant points at that exact path via
# Node's native --env-file flag — update it there if you move this file again.
# For one-off CLI commands (prisma migrate deploy, prisma/seed.mjs), which
# don't know about --env-file, `source` this file into the shell first — see
# DEPLOYMENT.md step 5.
#
# (For local dev only, the equivalent file is still plain backend/.env,
# loaded the same way by `pnpm dev`/`pnpm start` — see backend/.env.example.)
# =============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ─── Database ─────────────────────────────────────────────────────────────────
# Postgres installed natively on this VPS, not Docker (see DEPLOYMENT.md step 3).
# Must be bound to 127.0.0.1 only — never expose 5432 publicly.
DATABASE_URL="postgresql://genxqr:CHANGE_ME_STRONG_DB_PASSWORD@127.0.0.1:5432/genxqr?schema=public"

# ─── Redis ────────────────────────────────────────────────────────────────────
# Also native (see DEPLOYMENT.md step 3). Bind to 127.0.0.1 only.
REDIS_URL="redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@127.0.0.1:6379"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate two DIFFERENT strong secrets — never reuse dev secrets in production:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="CHANGE_ME_USE_A_STRONG_RANDOM_64_CHAR_HEX_SECRET"
JWT_REFRESH_SECRET="CHANGE_ME_USE_A_DIFFERENT_STRONG_RANDOM_64_CHAR_HEX_SECRET"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ─── Google OAuth (optional — omit to disable Google login) ──────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="https://genxqr.com/api/auth/google/callback"
GOOGLE_DRIVE_REDIRECT_URI="https://genxqr.com/api/auth/gdrive/callback"

# ─── Frontend / Backend URLs ──────────────────────────────────────────────────
FRONTEND_URL="https://genxqr.com"
BACKEND_URL="https://genxqr.com"

# ─── Email ────────────────────────────────────────────────────────────────────
# Option 1: Resend (recommended)
RESEND_API_KEY=""

# Option 2: SMTP (fallback — only used if RESEND_API_KEY is empty)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

EMAIL_FROM="GenXQR <no-reply@genxqr.com>"

# ─── PayU (live merchant credentials — get from https://dashboard.payu.in) ────
PAYU_MERCHANT_KEY="your_live_merchant_key_here"
PAYU_MERCHANT_SALT="your_live_merchant_salt_here"
# LIVE endpoint — do not use test.payu.in in production:
PAYU_BASE_URL="https://secure.payu.in/_payment"
