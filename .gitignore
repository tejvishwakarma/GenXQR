# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.next/
out/

# Archives / backups (don't commit large binary snapshots)
*.zip
*.tar
*.tar.gz

# Environment variables — NEVER commit these
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
*.swp
*.swo

# Prisma — migrations ARE source of truth and must be committed (prisma migrate
# deploy replays them to build production). Do not ignore them.

# Uploads / temp / runtime data
uploads/
tmp/
backend/data/


# Leftover terminal sessions saved as files
backend/l*

# Temporary error / build log dumps
frontend/err.txt
frontend/pnpm_err.txt
frontend/tsc_errors.txt

# AI assistant context (machine-local)
.claude/

# Planning / internal docs
Planning/

backend.env.txt
Cloudflare Origin Certificate.txt
*.env.txt
*Certificate*.txt

# Test *output* only — the test suites themselves are source and must be
# committed. (A blanket `tests/` rule here previously would have silently
# excluded them, the same way `backend/scripts/` once excluded real
# deployment scripts.)
coverage/
.vitest/