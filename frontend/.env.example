# Frontend environment variables — copy to `.env` for local development.
#
# WARNING: every VITE_* variable is inlined into the client bundle at build time
# and is therefore PUBLIC. Never put a secret, API key, or token here. Backend
# secrets belong in backend/.env.
#
# Save this file as UTF-8. A UTF-16 file parses as garbage and Vite silently
# ignores every variable in it — which is exactly what happened to
# .env.production and hid a wrong value for months.

# ─── API ──────────────────────────────────────────────────────────────────────
# Empty = same origin. That is correct for BOTH dev (Vite proxies /api/* to
# localhost:3001) and production (Nginx proxies /api/* to the backend).
# Only set an absolute URL when the API genuinely lives on another host.
VITE_API_URL=

# ─── Site identity ────────────────────────────────────────────────────────────
# Canonical public origin, used for the sitemap, canonical tags and JSON-LD.
# Blank falls back to https://genxqr.com (see src/lib/site.ts).
VITE_SITE_URL=

# ─── Google Analytics 4 ───────────────────────────────────────────────────────
# Measurement id from Google Analytics → Admin → Data Streams → your web stream.
# Format G-XXXXXXXXXX. A UA-… id is Universal Analytics and no longer works.
#
# Leave BLANK to disable analytics completely: no gtag.js request, no data sent.
# Keep it blank in development so local browsing does not pollute the property.
#
# Production also needs the CSP to allow googletagmanager.com (script-src) and
# *.google-analytics.com (connect-src) — already configured in
# deploy/cloudpanel-vhost-nodejs.conf. Without it GA loads but collects nothing.
VITE_GA_MEASUREMENT_ID=

# ─── LAN testing (optional) ───────────────────────────────────────────────────
# Overrides the origin embedded INSIDE generated QR codes, so a code scanned
# from a phone resolves to your dev machine rather than localhost.
# Example: https://192.168.1.20:5173 — leave empty to use window.location.origin.
VITE_PUBLIC_BASE_URL=
